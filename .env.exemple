# Configurações do ZunkoBall. Depois de editar, reinicie o servidor (npm start).
# Não compartilhe este arquivo: quando tiver a senha do MySQL, ela fica aqui.

# Admins do painel (/admin.html): nome de usuário (login) da conta, separado por vírgula
ZUNKO_ADMINS=feedback

# MySQL dos itens exclusivos (apague o # das 5 linhas para ativar; sem isso usa o arquivo db.json)
#MYSQL_HOST=127.0.0.1
#MYSQL_PORT=3306
#MYSQL_USER=zunko
#MYSQL_PASSWORD=troque-esta-senha
#MYSQL_DATABASE=zunkoball
